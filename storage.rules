rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Receipts and ticket images are written and read only via the Admin SDK.
    match /screenshots/{registrantId}/{fileName} {
      allow read, write: if false;
    }

    match /tickets/{registrantId}/{fileName} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
