rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Public Registration ───────────────────────────────────────
    // Anyone can CREATE a registrant doc (no auth required for registration).
    // No one can update/delete from the client — only Cloud Functions via Admin SDK.
    match /registrants/{registrantId} {
      allow create: if true
        && request.resource.data.keys().hasAll([
          'fullName', 'phoneNumber', 'whatsappNumber', 'church',
          'paymentScreenshotUrl', 'status', 'ocrStatus', 'createdAt'
        ])
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.ocrStatus == 'queued'
        && request.resource.data.fullName is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.whatsappNumber is string
        && request.resource.data.church is string
        && request.resource.data.paymentScreenshotUrl is string;

      allow read: if true;  // Status page needs to read own doc (no auth)
      allow update, delete: if false;  // Only Admin SDK (Cloud Functions / API routes)
    }

    // ─── Phone Uniqueness Index ────────────────────────────────────
    // Created in the same transaction as the registrant doc.
    // If this doc already exists, the transaction aborts → duplicate prevention.
    match /phoneIndex/{phoneNumber} {
      allow create: if true
        && request.resource.data.keys().hasAll(['registrantId'])
        && request.resource.data.registrantId is string;

      allow read: if true;
      allow update, delete: if false;
    }

    // ─── Bank Transactions ─────────────────────────────────────────
    // Written only by Cloud Functions (Admin SDK) or authenticated admins.
    match /bankTransactions/{referenceNumber} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // ─── Tickets ───────────────────────────────────────────────────
    // Written only by Cloud Functions. Ushers can read for display.
    match /tickets/{registrantId} {
      allow read: if true;  // Ticket page is auth-free (unguessable UUID)
      allow write: if false; // Only Admin SDK
    }

    // ─── Staff ─────────────────────────────────────────────────────
    // Staff can read their own doc. Only Admin SDK writes.
    match /staff/{authUid} {
      allow read: if request.auth != null && request.auth.uid == authUid;
      allow write: if false; // Only Admin SDK
    }
  }
}
