rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // All registrant, ticket, and phone data is served by Admin SDK APIs.
    match /registrants/{registrantId} {
      allow read, write: if false;
    }

    match /phoneIndex/{phoneNumber} {
      allow read, write: if false;
    }

    match /tickets/{registrantId} {
      allow read, write: if false;
    }

    match /bankTransactions/{referenceNumber} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /staff/{authUid} {
      allow read: if request.auth != null && request.auth.uid == authUid;
      allow write: if false;
    }

    match /admins/{email} {
      allow read, write: if false;
    }

    match /receipts/{registrantId} {
      allow read, write: if false;
    }

    match /rateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
