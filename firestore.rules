rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        (
          request.auth.token.email is string &&
          (
            request.auth.token.email.lower() == 'tonysaleeb23@gmail.com' ||
            exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
          )
        )
      );
    }

    // All registrant, ticket, and phone data is served by Admin SDK APIs.
    match /registrants/{registrantId} {
      allow read, write: if false;
    }

    match /phoneIndex/{phoneNumber} {
      allow read, write: if false;
    }

    match /tickets/{registrantId} {
      allow read, write: if false;
    }

    match /bankTransactions/{referenceNumber} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /staff/{authUid} {
      allow read: if request.auth != null && request.auth.uid == authUid;
      allow write: if false;
    }

    match /admins/{email} {
      allow read, write: if false;
    }

    match /receipts/{registrantId} {
      allow read, write: if false;
    }

    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    match /meta/reviewQueue {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
